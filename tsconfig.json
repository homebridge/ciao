{
    "compilerOptions": {
        "target": "ES2024",
        "useDefineForClassFields": false,
        "module": "commonjs",
        "importHelpers": true,
        "lib": ["es2024"],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "lib",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "preserveConstEnums": true,
        "useUnknownInCatchVariables": false,
        "types": ["node", "jest"]
    },
    "include": [
        "src/"
    ],
    "exclude": [
        "**/*.spec.ts"
    ]
}
